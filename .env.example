# Copy this file to .env (or .env.local) and edit the values.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Base URL for the Laravel backend API.
# Should point to /api — service files prepend specific paths
# like /auth/login, /auth/me, etc.
#
# Local dev example:
VITE_API_URL=http://127.0.0.1:8000/api

# Production example:
# VITE_API_URL=https://api.taahud.example.com/api

# NOTE: no Moyasar key belongs here. Every payment (subscriptions AND
# project-step escrow) is created by the backend, which returns its own
# publishable key in the checkout session config. Keeping a second copy
# in the frontend build would just be another thing to rotate.
